    { "bn": "ওই মানুষটি খুব ভালো।", "pronunciation": "oi manush-ti khub bhalo", "en": "That person is very kind.", "context": "Using মানুষ (person)", "category": "nouns" },
    { "bn": "রাহিম আমার বন্ধু।", "pronunciation": "Rahim amar bondhu", "en": "Rahim is my friend.", "context": "Using বন্ধু (friend)", "category": "nouns" },
    { "bn": "আমার পরিবার ঢাকায় থাকে।", "pronunciation": "amar poribar Dhakay thake", "en": "My family lives in Dhaka.", "context": "Using পরিবার (family)", "category": "nouns" },
    { "bn": "আমাদের বাড়ি ছোট।", "pronunciation": "amader bari chhoto", "en": "Our house is small.", "context": "Using বাড়ি (house)", "category": "nouns" },
    { "bn": "স্কুল সকাল আটটায় শুরু হয়।", "pronunciation": "skul shokal at-tay shuru hoy", "en": "School starts at eight in the morning.", "context": "Using স্কুল (school)", "category": "nouns" },
    { "bn": "এটা আমার প্রিয় বই।", "pronunciation": "eta amar priyo boi", "en": "This is my favorite book.", "context": "Using বই (book)", "category": "nouns" },
    { "bn": "দয়া করে আমাকে পানি দিন।", "pronunciation": "doya kore amake pani din", "en": "Please give me water.", "context": "Using পানি (water)", "category": "nouns" },
    { "bn": "খাবার টেবিলে রাখা আছে।", "pronunciation": "khabar tebile rakha achhe", "en": "The food is on the table.", "context": "Using খাবার (food)", "category": "nouns" },
    { "bn": "আজ একটি সুন্দর দিন।", "pronunciation": "aj ekti shundor din", "en": "Today is a beautiful day.", "context": "Using দিন (day)", "category": "nouns" },
    { "bn": "আমার এখন সময় নেই।", "pronunciation": "amar ekhon shomoy nei", "en": "I do not have time now.", "context": "Using সময় (time)", "category": "nouns" },
    { "bn": "এই রাস্তা স্টেশনে যায়।", "pronunciation": "ei rasta steshone jay", "en": "This road goes to the station.", "context": "Using রাস্তা (road)", "category": "nouns" },
    { "bn": "এই শহর অনেক বড়।", "pronunciation": "ei shohor onek boro", "en": "This city is very large.", "context": "Using শহর (city)", "category": "nouns" }
  ],
