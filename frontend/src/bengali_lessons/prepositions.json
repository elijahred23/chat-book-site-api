  "phrases": [
    { "bn": "বাক্সের মধ্যে একটি বই আছে।", "pronunciation": "baksher moddhe ekti boi achhe", "en": "There is a book inside the box.", "context": "Using মধ্যে (in / among)", "category": "prepositions" },
    { "bn": "বইটি টেবিলের উপরে আছে।", "pronunciation": "boiti tebiler upore achhe", "en": "The book is on the table.", "context": "Using উপরে (on / above)", "category": "prepositions" },
    { "bn": "বিড়ালটি টেবিলের নিচে আছে।", "pronunciation": "biralti tebiler niche achhe", "en": "The cat is under the table.", "context": "Using নিচে (under / below)", "category": "prepositions" },
    { "bn": "গাড়িটি বাড়ির সামনে আছে।", "pronunciation": "gariti barir shamne achhe", "en": "The car is in front of the house.", "context": "Using সামনে (in front of)", "category": "prepositions" },
    { "bn": "বাগানটি বাড়ির পিছনে।", "pronunciation": "baganti barir pichhone", "en": "The garden is behind the house.", "context": "Using পিছনে (behind)", "category": "prepositions" },
    { "bn": "স্কুলটি বাড়ির পাশে।", "pronunciation": "skulti barir pashe", "en": "The school is beside the house.", "context": "Using পাশে (beside)", "category": "prepositions" },
    { "bn": "আমার কাছে একটি কলম আছে।", "pronunciation": "amar kachhe ekti kolom achhe", "en": "I have a pen with me.", "context": "Using কাছে (near / with)", "category": "prepositions" },
    { "bn": "আমি ঢাকা থেকে এসেছি।", "pronunciation": "ami Dhaka theke eshechhi", "en": "I have come from Dhaka.", "context": "Using থেকে (from)", "category": "prepositions" },
    { "bn": "দোকানটি রাত দশটা পর্যন্ত খোলা।", "pronunciation": "dokanti rat doshta porjonto khola", "en": "The shop is open until ten at night.", "context": "Using পর্যন্ত (until / up to)", "category": "prepositions" },
    { "bn": "এই উপহারটি তোমার জন্য।", "pronunciation": "ei upoharti tomar jonno", "en": "This gift is for you.", "context": "Using জন্য (for)", "category": "prepositions" },
    { "bn": "আমি বন্ধুর সঙ্গে যাচ্ছি।", "pronunciation": "ami bondhur shonge jacchhi", "en": "I am going with a friend.", "context": "Using সঙ্গে (with)", "category": "prepositions" },
    { "bn": "পানি ছাড়া আমরা বাঁচতে পারি না।", "pronunciation": "pani chhara amra bachte pari na", "en": "We cannot live without water.", "context": "Using ছাড়া (without / except)", "category": "prepositions" }
  ],
