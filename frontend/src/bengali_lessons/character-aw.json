    { "bn": "আমি ভালো আছি।", "pronunciation": "ami bhalo achhi.", "en": "I am well.", "context": "Introduce yourself and describe how you feel.", "category": "character-aw" },
    { "bn": "আমার নাম…", "pronunciation": "amar nam…", "en": "My name is…", "context": "Introduce yourself.", "category": "character-aw" },
    { "bn": "আমার একটা প্রশ্ন আছে।", "pronunciation": "amar ekta proshno achhe.", "en": "I have a question.", "context": "Introduce a question.", "category": "character-aw" },
    { "bn": "আপনি কেমন আছেন?", "pronunciation": "apni kemon achhen?", "en": "How are you?", "context": "Ask politely how someone is.", "category": "character-aw" },
    { "bn": "আবার বলুন।", "pronunciation": "abar bolun.", "en": "Say it again.", "context": "Make a polite request for repetition.", "category": "character-aw" },
