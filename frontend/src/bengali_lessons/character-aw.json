    { "bn": "আজ কী বার?", "pronunciation": "aj ki bar?", "en": "What day is today?", "context": "Ask the day of the week.", "category": "character-aw" },
    { "bn": "আজ যাব।", "pronunciation": "aj jabo.", "en": "I will go today.", "context": "Describe a plan for today.", "category": "character-aw" },
    { "bn": "আমার ভালো লাগছে।", "pronunciation": "amar bhalo lagchhe.", "en": "I like it / I'm enjoying it.", "context": "Express a positive feeling.", "category": "character-aw" },
    { "bn": "আমার ভালো লাগছে না।", "pronunciation": "amar bhalo lagchhe na.", "en": "I don't like it / I'm not feeling well.", "context": "Express dislike or discomfort.", "category": "character-aw" },
    { "bn": "আমার জানা নেই।", "pronunciation": "amar jana nei.", "en": "I don't know.", "context": "Say that you do not know something.", "category": "character-aw" },
    { "bn": "আমার মনে হয়…", "pronunciation": "amar mone hoy…", "en": "I think…", "context": "Introduce an opinion.", "category": "character-aw" },
    { "bn": "আমার কাছে আছে।", "pronunciation": "amar kachhe achhe.", "en": "I have it.", "context": "Say that you possess something.", "category": "character-aw" },
    { "bn": "আর কিছু?", "pronunciation": "ar kichhu?", "en": "Anything else?", "context": "Ask whether anything more is needed.", "category": "character-aw" },
    { "bn": "আর কত?", "pronunciation": "ar koto?", "en": "How much more?", "context": "Ask about an additional amount.", "category": "character-aw" },
    { "bn": "আবার দেখা হবে।", "pronunciation": "abar dekha hobe.", "en": "See you again.", "context": "Say goodbye with the expectation of meeting again.", "category": "character-aw" },
    { "bn": "আসলে কী হয়েছে?", "pronunciation": "ashole ki hoyeche?", "en": "What actually happened?", "context": "Ask what really happened.", "category": "character-aw" },
    { "bn": "এখানে আসুন।", "pronunciation": "ekhane ashun.", "en": "Come here.", "context": "Make a polite request.", "category": "character-aw" },
    { "bn": "আমার সাথে আসুন।", "pronunciation": "amar shathe ashun.", "en": "Come with me.", "context": "Invite someone to accompany you.", "category": "character-aw" },
